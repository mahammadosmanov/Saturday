{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S.A.T.U.R.D.A.Y",
  "version": "0.3.1",
  "identifier": "dev.rohtolos.saturday",
  "build": {
    "beforeDevCommand": "npm run prepare:stage1-owner-authorization && npm run prepare:voice-owner-binding && npm run build:native-helper && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:stage1-owner-authorization && npm run prepare:voice-owner-binding && npm run build:native-helper && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "S.A.T.U.R.D.A.Y — Personal command interface",
        "width": 960,
        "height": 720,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#060d13",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; media-src 'none'; base-uri 'none'",
      "capabilities": [
        "voice-main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/saturday-runtime-helper"
    ],
    "resources": {
      "generated/helper-identity.json": "saturday-resources/helper-identity.json",
      "generated/stage1": "saturday-resources/stage1",
      "native/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "native/tr.lproj/InfoPlist.strings": "tr.lproj/InfoPlist.strings",
      "target/voice-owner-build/voice-asset-bindings.json": "saturday-resources/voice-asset-bindings.json"
    },
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "An animated local-first personal command interface",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
